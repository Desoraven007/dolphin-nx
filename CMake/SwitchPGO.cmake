option(DOLPHIN_SWITCH_PGO "Use the bundled Switch optimization profile" ON)

function(dolphin_switch_profile_targets directory)
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS targets)
    get_target_property(type ${target} TYPE)
    if(type MATCHES "^(STATIC_LIBRARY|OBJECT_LIBRARY|SHARED_LIBRARY|EXECUTABLE)$")
      target_compile_options(${target} PRIVATE
        "$<$<COMPILE_LANGUAGE:C,CXX>:${_switch_pgo_flags}>")
    endif()
  endforeach()
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    string(FIND "${child}/" "${CMAKE_SOURCE_DIR}/Source/Core/" in_core)
    if(in_core EQUAL 0)
      dolphin_switch_profile_targets("${child}")
    endif()
  endforeach()
endfunction()

function(dolphin_switch_enable_pgo)
  if(NOT DOLPHIN_SWITCH_PGO OR NOT CMAKE_BUILD_TYPE STREQUAL "Release")
    return()
  endif()
  set(archive "${CMAKE_SOURCE_DIR}/Tools/Switch/pgo/profile.zip")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${archive}")
  file(SHA256 "${archive}" digest)
  set(profile_dir "${CMAKE_BINARY_DIR}/pgo/${digest}")
  if(NOT EXISTS "${profile_dir}/profile.json")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${profile_dir}")
  endif()
  file(READ "${profile_dir}/profile.json" profile)
  string(JSON compiler_version GET "${profile}" compiler_version)
  if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU" OR
     NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL compiler_version)
    message(FATAL_ERROR "The Switch PGO profile requires GCC ${compiler_version}; disable DOLPHIN_SWITCH_PGO to use another compiler")
  endif()
  if(DOLPHIN_SWITCH_DEKO3D_RUNTIME)
    set(variant deko3d)
  else()
    set(variant main)
  endif()
  set(prefix "${CMAKE_BINARY_DIR}")
  find_program(_switch_pgo_cygpath cygpath)
  if(_switch_pgo_cygpath)
    execute_process(COMMAND "${_switch_pgo_cygpath}" -w "${prefix}"
      OUTPUT_VARIABLE prefix OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  else()
    file(TO_NATIVE_PATH "${prefix}" prefix)
  endif()
  set(_switch_pgo_flags "-fprofile-prefix-path=${prefix}"
    "-fprofile-use=${profile_dir}/${variant}" -fno-profile-values -fprofile-correction
    -fprofile-partial-training -Wno-missing-profile -Wno-error=coverage-mismatch)
  dolphin_switch_profile_targets("${CMAKE_SOURCE_DIR}/Source/Core")
  target_link_options(dolphin-switch PRIVATE ${_switch_pgo_flags})
  message(STATUS "Switch PGO: ${variant}")
endfunction()
